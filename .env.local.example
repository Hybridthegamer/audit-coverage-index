# Neon Postgres — dev branch. HTTP driver (@neondatabase/serverless) uses this same URL.
# A pooler URL is fine for the HTTP/SQL-over-HTTP driver.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public origin for canonical URLs, robots.txt, sitemap and OG image URLs.
# Leave unset locally (falls back to http://localhost:3000). On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL until the custom domain is set,
# at which point set it to the real origin, e.g.
# NEXT_PUBLIC_SITE_URL="https://auditcoverage.xyz"
NEXT_PUBLIC_SITE_URL=

# ── Workspace auth (build step 4) ──────────────────────────────────────────
# Single-user gate for /workspace/*. Both are required and server-only (never
# prefix with NEXT_PUBLIC_ — that would ship them to the browser).
#
# WORKSPACE_PASSWORD is the login secret. WORKSPACE_SESSION_SECRET is the HMAC
# key the session cookie is signed with; rotating it signs everyone out.
# Generate a secret with:  openssl rand -base64 32
WORKSPACE_PASSWORD=
WORKSPACE_SESSION_SECRET=
