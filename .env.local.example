# Neon Postgres — dev branch. HTTP driver (@neondatabase/serverless) uses this same URL.
# A pooler URL is fine for the HTTP/SQL-over-HTTP driver.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public origin for canonical URLs, robots.txt, sitemap and OG image URLs.
# Leave unset locally (falls back to http://localhost:3000). On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL until the custom domain is set,
# at which point set it to the real origin, e.g.
# NEXT_PUBLIC_SITE_URL="https://auditcoverage.xyz"
NEXT_PUBLIC_SITE_URL=

# ── Workspace auth (build step 4) ──────────────────────────────────────────
# Single-user gate for /workspace/*. Both are required and server-only (never
# prefix with NEXT_PUBLIC_ — that would ship them to the browser).
#
# WORKSPACE_PASSWORD is the login secret. WORKSPACE_SESSION_SECRET is the HMAC
# key the session cookie is signed with; rotating it signs everyone out.
# Generate a secret with:  openssl rand -base64 32
WORKSPACE_PASSWORD=
WORKSPACE_SESSION_SECRET=

# ── Curation thresholds (build step 6) ─────────────────────────────────────
# All optional; an unset or unparseable value falls back to the default rather
# than aborting a run. Server-only — none may become NEXT_PUBLIC_, because the
# curation policy is the shape of the private research queue.
#
# DEFILLAMA_MIN_TVL_USD=1000000      # floor; default 1000000
# DEFILLAMA_MAX_TVL_USD=50000000     # ceiling; default 50000000, 0 = none
# DEFILLAMA_CATEGORIES=Dexs,Lending  # allowlist; default all
# DEFILLAMA_CHAINS=Ethereum,Base     # allowlist; default all
# DEFILLAMA_INCLUDE_INACTIVE=false   # keep rugged/deprecated/dead rows
# DEFILLAMA_MAX_PROTOCOLS=0          # 0 = no cap

# ── Block explorer (build step 7) ──────────────────────────────────────────
# Etherscan V2 is ONE API across every supported chain (Ethereum, Optimism,
# BNB, Polygon, Base, Arbitrum), selected by a `chainid` parameter — so this is
# a single key, not the old per-chain Etherscan/Basescan/Arbiscan trio. Get one
# free at https://etherscan.io/apis.
#
# Required for `npm run db:onchain` and the in-app "Resolve on-chain" buttons.
# Without it, pinning contracts still works; nothing resolves automatically.
# Server-only — a key in the client bundle is a key someone else is using by
# tomorrow.
ETHERSCAN_API_KEY=

# Optional explorer knobs.
#   EXPLORER_THROTTLE_MS   ms between calls, default 250. The free tier allows
#                          5 calls/sec and one address costs 7, so pacing is
#                          cheaper than parsing your way out of a throttle.
#   EXPLORER_MAX_UPGRADES  upgrade_events written per deployment, default 200.
# EXPLORER_THROTTLE_MS=250
# EXPLORER_MAX_UPGRADES=200

# ── GitHub audit discovery (build step 7) ──────────────────────────────────
# Optional. Discovery reads PUBLIC repositories only, so it works with no token
# at 60 calls/hour — enough for interactive use from a protocol page. A
# read-only fine-grained token with public-repo access raises that to 5,000/hr,
# which is what a `npm run db:audits` sweep wants. Server-only: it is a
# credential and must never become NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional discovery knobs.
#   GITHUB_MAX_REPORTS      reports imported per repo, default 40
#   GITHUB_RESOLVE_COMMITS  "false" skips the per-file commit lookup (cheaper,
#                           but no candidate reviewed commit in the scope note)
# GITHUB_MAX_REPORTS=40
# GITHUB_RESOLVE_COMMITS=true
